{
  "nombre": "demo",
  "descripcion": "Demostración: configuración B con aprobación humana para guardar.",
  "instrucciones": [
    "agente/instrucciones_genericas.md",
    "skill/SKILL.md"
  ],
  "modelo": "claude-sonnet-5-5",
  "esfuerzo": "medium",
  "politica": "politica/politica_demo.json",
  "limites": {
    "max_pasos": 30,
    "presupuesto_tokens": 400000,
    "max_tokens_por_respuesta": 16000
  },
  "carpeta_trazas": "trazas/demo",
  "carpeta_salidas": "resultados/salidas/demo",
  "casos": "eval/demo/casos_demo.jsonl",
  "servidores": [
    {
      "nombre": "lesco",
      "comando": [
        "python",
        "mcp_server/servidor_lesco.py",
        "--casos",
        "{casos}",
        "--salidas",
        "{salidas}"
      ]
    }
  ],
  "guion_simulado": "agente/guion_simulado.json",
  "envolver_resultados": true
}
