{"caso_id": "c001", "texto": "Debe firmar el certificado."}
{"caso_id": "c002", "texto": "Necesita pagar la factura hoy."}
{"caso_id": "c003", "texto": "Espere en la fila, por favor."}
{"caso_id": "c004", "texto": "La oficina abre el lunes."}
{"caso_id": "c005", "texto": "El horario es de lunes a viernes."}
{"caso_id": "c006", "texto": "Escriba su nombre y apellido."}
{"caso_id": "c007", "texto": "Traiga una foto."}
{"caso_id": "c008", "texto": "¿Cuánto debo pagar?"}
{"caso_id": "c009", "texto": "¿Dónde atiende el director?"}
{"caso_id": "c010", "texto": "Hoy no hay intérprete."}
{"caso_id": "c011", "texto": "Necesito hablar con un abogado."}
{"caso_id": "c012", "texto": "Debe esperar quince minutos."}
{"caso_id": "c013", "texto": "El banco cierra a las cuatro."}
{"caso_id": "c014", "texto": "Puede pagar con dólares o colones."}
{"caso_id": "c015", "texto": "Envíe el formulario por correo electrónico."}
{"caso_id": "c016", "texto": "Gracias por esperar."}
{"caso_id": "c017", "texto": "Pregunte en la ventanilla número tres."}
{"caso_id": "c018", "texto": "El trámite dura dos semanas."}
{"caso_id": "c019", "texto": "Traiga la cédula y una fotocopia."}
{"caso_id": "c020", "texto": "La doctora lo atiende mañana en la mañana."}
{"caso_id": "c021", "texto": "Su cita es el martes."}
{"caso_id": "c022", "texto": "No tiene que pagar nada."}
{"caso_id": "c023", "texto": "El servicio es gratis."}
{"caso_id": "c024", "texto": "Llame por teléfono antes de venir."}
{"caso_id": "c025", "texto": "Debe presentar el expediente completo."}
{"caso_id": "c026", "texto": "Debe leer la carta."}
{"caso_id": "c027", "texto": "Necesita el permiso del ministerio."}
{"caso_id": "c028", "texto": "Puede leer la lista."}
{"caso_id": "c029", "texto": "Informe al empleado."}
{"caso_id": "c030", "texto": "Firme aquí, por favor."}
{"caso_id": "c031", "texto": "El empleado puede ayudar."}
{"caso_id": "c032", "texto": "Venga el jueves a las ocho."}
{"caso_id": "c033", "texto": "Tiene que traer dos fotos."}
{"caso_id": "c034", "texto": "Debe aprobar el examen."}
{"caso_id": "c035", "texto": "Hable despacio."}
{"caso_id": "c036", "texto": "El intérprete viene el viernes."}
{"caso_id": "c037", "texto": "Busque su expediente."}
{"caso_id": "c038", "texto": "Necesito un certificado nuevo."}
{"caso_id": "c039", "texto": "Hay un problema con su factura."}
{"caso_id": "c040", "texto": "Puede imprimir la factura."}
{"caso_id": "c041", "texto": "El doctor explica la medicina."}
{"caso_id": "c042", "texto": "Muestre el recibo al empleado."}
{"caso_id": "c043", "texto": "Debe cambiar el horario."}
{"caso_id": "c044", "texto": "El hospital atiende todo el día."}
{"caso_id": "c045", "texto": "Escriba un correo electrónico al director."}
{"caso_id": "c046", "texto": "Pida ayuda al intérprete."}
{"caso_id": "c047", "texto": "La universidad entrega el certificado en diciembre."}
{"caso_id": "c048", "texto": "Si no puede venir el lunes, debe avisar a la oficina antes del viernes."}
