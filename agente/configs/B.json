  "casos": "eval/casos.jsonl",
  "servidores": [
    {
      "nombre": "lesco",
      "comando": [
        "python",
        "mcp_server/servidor_lesco.py",
        "--casos",
        "{casos}",
        "--salidas",
        "{salidas}"
      ]
    }
  ],
  "guion_simulado": "agente/guion_simulado.json",
  "envolver_resultados": true
}
